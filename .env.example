# ==============================================================================
# QRServe Environment Configuration Template
# Copy this file to .env and configure with your real values.
# Do NOT commit actual secrets or credentials to source control.
# ==============================================================================

# Database Connection (PostgreSQL / Neon / Supabase / Cloud SQL)
#
# Option A: Standard / Local PostgreSQL
# DATABASE_URL="postgresql://username:password@localhost:5432/qrserve?schema=public"
#
# Option B: Neon Serverless PostgreSQL (Note: sslmode=require is required for Neon)
# DATABASE_URL="postgresql://username:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
#
DATABASE_URL="postgresql://username:password@localhost:5432/qrserve?schema=public"

# Authentication & Session Security
# Generate a cryptographically random secret using: openssl rand -base64 32
JWT_SECRET="replace_with_a_secure_random_32_byte_secret"
COOKIE_NAME="qrserve_session"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Super Admin Security & Identity Enforce
# Designated Super Admin Email (Server-side constraint)
# When set, ONLY this verified account with role SUPER_ADMIN and valid credentials can access /admin and Admin APIs.
# SUPER_ADMIN_EMAIL="your-designated-admin@gmail.com"
#
# Initial Super Admin Provisioning (Used strictly via CLI script: npm run seed:admin)
# Never exposed to the browser or public registration.
# INITIAL_SUPER_ADMIN_NAME="QRServe Administrator"
# INITIAL_SUPER_ADMIN_EMAIL="admin@qrserve.com"
# INITIAL_SUPER_ADMIN_PASSWORD="replace_with_a_strong_temporary_admin_password"

# Media & Storage Settings (Optional)
# By default, files are stored securely in ./storage/uploads/restaurants/<id>
# For persistent volume mount in container/VPS environments, specify STORAGE_DIR:
# STORAGE_DIR="/var/data/qrserve/storage"
#
# For serverless / multi-instance deployments requiring S3-compatible cloud object storage (e.g. AWS S3, Cloudflare R2, Supabase Storage):
# S3_BUCKET="qrserve-food-images"
# S3_REGION="auto"
# S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID="your_access_key_id"
# S3_SECRET_ACCESS_KEY="your_secret_access_key"

